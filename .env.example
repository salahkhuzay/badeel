# إعدادات النشر الاختيارية
# للمشاريع على استضافة ثابتة/سحابية (Vercel · Netlify · Cloudflare Pages · أي خادم Node.js)

# ------------------------------ المنافذ والمضيف ------------------------------
PORT=3000
HOSTNAME=0.0.0.0

# ملاحظة أمنية: لا تضع أي بيانات اعتماد أو مفاتيح سرية في هذا الملف.
# في الإنتاج تُضاف المتغيرات من لوحة الاستضافة (Environment Variables).

# ------------------------------ عند ربط قاعدة بيانات لاحقاً ------------------------------
# DATABASE_URL=postgresql://user:password@host:5432/badeel
# ADMIN_JWT_SECRET=ضع-قيمة-عشوائية-طويلة-هنا
# ضع نطاقك الحقيقي بعد النشر (مثال: https://your-project.vercel.app)
# NEXT_PUBLIC_SITE_URL=https://example.com
